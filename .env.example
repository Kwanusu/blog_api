# Copy this file to ".env" and fill in the values. ".env" is ignored by git; this example is safe to commit.
# Only SECRET_KEY is required. Everything else has a development-friendly default.

# --- Core ---------------------------------------------------------------
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# sqlite (default) needs nothing. For PostgreSQL set DB_BACKEND=postgres and DATABASE_URL, and install psycopg.
DB_BACKEND=sqlite
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Optional shared cache for throttling when running several workers (pip install redis):
# REDIS_URL=redis://localhost:6379/1

# --- Email (leave EMAIL_HOST empty to print emails in the terminal) -------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_NAME=Blog API
SITE_URL=http://localhost:8000
PASSWORD_RESET_URL=http://localhost:5173/reset-password
TEACHER_SETUP_URL=http://localhost:5173/reset-password

# --- Cloudinary (image uploads) -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# --- M-Pesa ---------------------------------------------------------------
# MPESA_ENV: sandbox | production | simulate (simulate needs no credentials and only works with DEBUG=True)
MPESA_ENV=simulate
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=

# --- Production hardening (only used when DEBUG=False) ----------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# BEHIND_PROXY=True
